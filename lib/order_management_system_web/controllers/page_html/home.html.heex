<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="bg-gray-100 text-black">
    <!-- Dashboard Header -->
    <div class="border-b-2 border-black bg-white">
      <div class="flex items-center justify-between px-6 py-3 lg:px-8">
        <div>
          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900">
            Order Management System
          </h1>
          <h1 class="mt-0.5 text-2xl font-bold">Dashboard</h1>
        </div>

        <.link
          navigate={~p"/orders/new"}
          class="rounded-lg border-2 border-black bg-black px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800"
        >+ Create Order</.link>
      </div>
    </div>

    <!-- Dashboard Content -->
    <main class="px-6 py-4 lg:px-8">
      <!-- Overview -->
      <div class="mb-3">
        <h2 class="text-lg font-bold">Overview</h2>
      </div>

      <!-- Statistics Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <!-- Total Orders -->
        <.link
          navigate={~p"/orders"}
          class="group rounded-xl border-2 border-black bg-white p-4 shadow-sm transition hover:bg-gray-50"
        >
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-500">Total Orders</p>
              <p class="mt-1 text-3xl font-bold">{@stats.total}</p>
            </div>

            <div class="flex h-10 w-10 items-center justify-center rounded-lg border-2 border-black bg-gray-100 text-xs font-bold">
              All
            </div>
          </div>

          <div class="mt-4 border-t border-gray-200 pt-3">
            <p class="text-sm font-semibold text-gray-700 group-hover:text-black">
              View all orders →
            </p>
          </div>
        </.link>

        <!-- Completed -->
        <.link
          navigate={~p"/orders?status=completed"}
          class="group rounded-xl border-2 border-black bg-white p-4 shadow-sm transition hover:bg-gray-50"
        >
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-500">Completed</p>
              <p class="mt-1 text-3xl font-bold">{@stats.completed}</p>
            </div>
            <div class="flex h-10 w-10 items-center justify-center rounded-lg border-2 border-green-500 bg-green-50 text-green-700">
              ✓
            </div>
          </div>

          <div class="mt-4 border-t border-gray-200 pt-3">
            <p class="text-sm font-semibold text-gray-700 group-hover:text-black">
              View completed orders →
            </p>
          </div>
        </.link>

        <!-- Pending -->
        <.link
          navigate={~p"/orders?status=pending"}
          class="group rounded-xl border-2 border-black bg-white p-4 shadow-sm transition hover:bg-gray-50"
        >
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-500">Pending</p>
              <p class="mt-1 text-3xl font-bold">{@stats.pending}</p>
            </div>

            <div class="flex h-10 w-10 items-center justify-center rounded-lg border-2 border-yellow-500 bg-yellow-50 text-yellow-700">
              !
            </div>
          </div>

          <div class="mt-4 border-t border-gray-200 pt-3">
            <p class="text-sm font-semibold text-gray-700 group-hover:text-black">
              View pending orders →
            </p>
          </div>
        </.link>

        <!-- Cancelled -->
        <.link
          navigate={~p"/orders?status=cancelled"}
          class="group rounded-xl border-2 border-black bg-white p-4 shadow-sm transition hover:bg-gray-50"
        >
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-500">Cancelled</p>
              <p class="mt-1 text-3xl font-bold">{@stats.cancelled}</p>
            </div>

            <div class="flex h-10 w-10 items-center justify-center rounded-lg border-2 border-red-500 bg-red-50 text-red-700">
              ×
            </div>
          </div>

          <div class="mt-4 border-t border-gray-200 pt-3">
            <p class="text-sm font-semibold text-gray-700 group-hover:text-black">
              View cancelled orders →
            </p>
          </div>
        </.link>
      </div>

      <!-- Customers -->
      <div class="mt-5 rounded-xl border-2 border-black bg-white p-5">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold">Customers</h2>
          </div>
          <div class="flex gap-3">
            <.link
              navigate={~p"/customers"}
              class="rounded-lg border-2 border-black bg-black px-5 py-2.5 text-sm font-semibold text-white hover:bg-gray-800"
            >View Customers</.link>

            <.link
              navigate={~p"/customers/new"}
              class="rounded-lg border-2 border-black bg-white px-5 py-2.5 text-sm font-semibold text-black hover:bg-gray-100"
            >+ Add New Customer</.link>
          </div>
        </div>
      </div>

      <!-- Recent Orders -->
      <div class="mt-5 rounded-xl border-2 border-black bg-white p-5">
        <div class="mb-4 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold">Recent Orders</h2>
          </div>

          <.link
            navigate={~p"/orders"}
            class="text-sm font-semibold text-gray-700 hover:text-black"
          >View All →</.link>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b-2 border-black">
                <th class="px-3 py-3 font-bold">Order ID</th>
                <th class="px-3 py-3 font-bold">Customer</th>
                <th class="px-3 py-3 font-bold">Items</th>
                <th class="px-3 py-3 font-bold">Status</th>
                <th class="px-3 py-3 text-right font-bold">Action</th>
              </tr>
            </thead>

            <tbody>
              <%= if @recent_orders == [] do %>
                <tr>
                  <td colspan="5" class="px-3 py-6 text-center text-gray-500">
                    No orders have been created yet.
                  </td>
                </tr>
              <% else %>
                <%= for order <- @recent_orders do %>
                  <tr class="border-b border-gray-200">
                    <td class="px-3 py-3 font-semibold">#{order.id}</td>
                    <td class="px-3 py-3">{order.customer.name}</td>
                    <td class="max-w-xs truncate px-3 py-3 text-gray-600">{order.items}</td>
                    <td class="px-3 py-3">
                      <%= cond do %>
                        <% order.status == "completed" -> %>
                          <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">Completed</span>
                        <% order.status == "pending" -> %>
                          <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">
                            Pending
                          </span>
                        <% order.status == "cancelled" -> %>
                          <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                            Cancelled
                          </span>
                        <% true -> %>
                          <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
                            {order.status}
                          </span>
                      <% end %>
                    </td>
                    <td class="px-3 py-3 text-right">
                      <.link
                        navigate={~p"/orders/#{order}"}
                        class="font-semibold text-gray-700 hover:text-black"
                      >View</.link>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</Layouts.app>
