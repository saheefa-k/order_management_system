<div class="min-h-screen bg-gray-100 py-12">
  <div class="mx-auto max-w-3xl px-6">

    <div class="mb-6 flex items-center justify-between">

      <.link navigate={~p"/orders"} class="text-sm font-medium text-gray-600 hover:text-black">
        ← Back to Orders
      </.link>

      <.link navigate={~p"/orders/#{@order}/edit"} 
      class="rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black">Edit Order
      </.link>

    </div>

    <div class="overflow-hidden rounded-2xl bg-white shadow-lg">

      <div class="border-b border-gray-200 bg-white px-8 py-7">

        <p class="text-sm font-medium text-gray-500">
          Order Details
        </p>

        <h1 class="mt-1 text-3xl font-bold text-gray-900">
          Order #<%= @order.id %>
        </h1>

      </div>

      <div class="grid gap-8 px-8 py-8">

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Customer</p>
          <p class="mt-2 text-lg font-semibold text-gray-900">Customer #<%= @order.customer_id %></p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Order Items</p>
          <div class="mt-2 rounded-lg border border-gray-200 bg-gray-50 p-4 text-gray-700"><%= @order.items %></div>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Status</p>
          <div class="mt-3">

            <%= cond do %>

              <% @order.status == "completed" -> %>
                <span class="rounded-full bg-green-100 px-4 py-2 text-sm font-semibold text-green-700">Completed</span>

              <% @order.status == "pending" -> %>
                <span class="rounded-full bg-yellow-100 px-4 py-2 text-sm font-semibold text-yellow-700">Pending</span>

              <% @order.status == "cancelled" -> %>
                <span class="rounded-full bg-red-100 px-4 py-2 text-sm font-semibold text-red-700">Cancelled</span>

              <% true -> %>
                <span class="rounded-full bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-600"><%= @order.status %></span>
            <% end %>

          </div>
        </div>

      </div>
      <div class="flex justify-end border-t border-gray-200 bg-gray-50 px-8 py-5">
        <.link
          href={~p"/orders/#{@order}"}
          method="delete"
          data-confirm="Are you sure you want to delete this order?"
          class="rounded-lg border border-red-200 bg-white px-5 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50"
        >Delete Order</.link>

      </div>

    </div>

  </div>
</div>