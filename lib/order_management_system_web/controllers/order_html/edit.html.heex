<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Edit Order {@order.id}
    <:subtitle>Use this form to manage order records in your database.</:subtitle>
  </.header>

  <.order_form changeset={@changeset} action={~p"/orders/#{@order}"} return_to={~p"/orders"} />
</Layouts.app>
